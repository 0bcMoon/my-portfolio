---
import portfolio from '../data/portfolio';
import Icon from './Icon.astro';

const { basics, socials } = portfolio;
---

<section id="hero" class="flex min-h-screen items-center justify-center px-6">
  <header class="text-center">
    <h1 class="text-5xl font-bold tracking-tight text-foreground sm:text-6xl md:text-7xl">{basics.name}</h1>
    <h2 class="mt-4 text-xl font-medium tracking-tight text-primary sm:text-2xl">{basics.label}</h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      {basics.bio}
    </p>

    <!-- Tech Stack -->
    <div class="mt-10">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground">Tech Stack</p>
      <div class="flex flex-wrap justify-center gap-3">
        {basics.techStack.map((tech) => (
          <span
            class="inline-flex items-center rounded-full border border-border bg-secondary px-4 py-2 text-sm font-medium text-secondary-foreground transition-colors hover:border-primary/30 hover:bg-primary/10 hover:text-primary"
          >
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- Social Links -->
    <ul class="mt-10 flex items-center justify-center gap-6" aria-label="Social media">
      {socials.map((social) => (
        <li>
          <a
            class="block rounded-full border border-border p-3 text-muted-foreground transition-all hover:border-primary hover:text-primary"
            href={social.url}
            target={social.url.startsWith('http') ? "_blank" : undefined}
            rel={social.url.startsWith('http') ? "noopener noreferrer" : undefined}
            aria-label={social.name}
          >
            <Icon name={social.icon} class="h-6 w-6" />
          </a>
        </li>
      ))}
    </ul>

    <!-- Scroll indicator -->
    <div class="mt-16 animate-bounce">
      <Icon name="chevron-down" class="mx-auto h-8 w-8 text-muted-foreground" />
    </div>
  </header>
</section>
