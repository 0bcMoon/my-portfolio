---
import portfolio from '../data/portfolio';

const { education } = portfolio;
---

<section id="education" class="flex min-h-screen items-center justify-center px-6 py-20" aria-label="Education">
  <div class="w-full max-w-3xl">
    <h2 class="mb-12 text-center text-sm font-bold uppercase tracking-widest text-primary">Education</h2>
    <div class="space-y-8">
      {education.map((edu) => (
        <div
          class="group relative rounded-xl border border-border bg-card p-8 transition-all hover:border-primary/30 hover:shadow-lg"
        >
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="text-xl font-semibold text-foreground">{edu.degree}</h3>
              <p class="mt-2 text-base font-medium text-primary">{edu.institution}</p>
              <p class="text-sm text-muted-foreground">{edu.location}</p>
            </div>
            <span class="mt-2 rounded-full bg-secondary px-4 py-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground sm:mt-0">
              {edu.period}
            </span>
          </div>
          <p class="mt-6 text-base leading-relaxed text-muted-foreground">{edu.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
