---
import portfolio from '../data/portfolio';

const { skills } = portfolio;
---

<section id="skills" class="flex min-h-screen items-center justify-center px-6 py-20" aria-label="Skills">
  <div class="w-full max-w-3xl">
    <h2 class="mb-12 text-center text-sm font-bold uppercase tracking-widest text-primary">Skills</h2>
    <div class="grid gap-8 sm:grid-cols-2">
      {skills.map((category) => (
        <div class="rounded-xl border border-border bg-card p-6">
          <h3 class="mb-5 text-base font-semibold text-foreground">{category.title}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span
                class="inline-flex items-center rounded-full border border-border bg-secondary px-4 py-2 text-sm font-medium text-secondary-foreground transition-colors hover:border-primary/30 hover:bg-primary/10 hover:text-primary"
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
