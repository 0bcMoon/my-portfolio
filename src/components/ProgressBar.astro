---
import portfolio from '../data/portfolio';

const { sections } = portfolio;
---

<!-- Top scroll progress bar -->
<div class="fixed left-0 top-0 z-50 h-1 w-full bg-secondary">
  <div
    id="scroll-progress-bar"
    class="h-full bg-primary transition-all duration-150 ease-out"
    style="width: 0%"
  >
  </div>
</div>

<!-- Side navigation dots -->
<nav class="fixed right-6 top-1/2 z-50 hidden -translate-y-1/2 flex-col gap-4 md:flex" aria-label="Section navigation">
  {sections.map((section, index) => (
    <button
      type="button"
      data-section-id={section.id}
      class="nav-dot-btn group flex items-center gap-3 cursor-pointer"
      aria-label={`Go to ${section.label}`}
    >
      <span
        data-label-id={section.id}
        class={`nav-label text-xs font-medium uppercase tracking-wider opacity-0 transition-opacity group-hover:opacity-100 ${index === 0 ? 'text-primary' : 'text-muted-foreground'}`}
      >
        {section.label}
      </span>
      <span
        data-dot-id={section.id}
        class={`nav-dot h-3 w-3 rounded-full border-2 transition-all ${index === 0 ? 'scale-125 border-primary bg-primary' : 'border-muted-foreground bg-transparent hover:border-primary'}`}
      >
      </span>
    </button>
  ))}
</nav>

<script>
  function setupProgressBar() {
    const progressBar = document.getElementById('scroll-progress-bar');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.nav-dot-btn');
    const labels = document.querySelectorAll<HTMLElement>('.nav-label');
    const dots = document.querySelectorAll<HTMLElement>('.nav-dot');

    const sectionIds = Array.from(buttons).map(b => b.dataset.sectionId).filter(Boolean) as string[];

    function updateScroll() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;

      if (progressBar) {
        progressBar.style.width = `${progress}%`;
      }

      // Determine active section
      let activeId = sectionIds[0] || 'hero';
      for (let i = sectionIds.length - 1; i >= 0; i--) {
        const el = document.getElementById(sectionIds[i]);
        if (el) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= window.innerHeight / 2) {
            activeId = sectionIds[i];
            break;
          }
        }
      }

      // Update dots & labels
      labels.forEach(label => {
        if (label.dataset.labelId === activeId) {
          label.classList.remove('text-muted-foreground');
          label.classList.add('text-primary');
        } else {
          label.classList.remove('text-primary');
          label.classList.add('text-muted-foreground');
        }
      });

      dots.forEach(dot => {
        if (dot.dataset.dotId === activeId) {
          dot.className = 'nav-dot h-3 w-3 rounded-full border-2 transition-all scale-125 border-primary bg-primary';
        } else {
          dot.className = 'nav-dot h-3 w-3 rounded-full border-2 transition-all border-muted-foreground bg-transparent hover:border-primary';
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.sectionId;
        if (id) {
          const target = document.getElementById(id);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
  }

  // Setup on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProgressBar);
  } else {
    setupProgressBar();
  }
</script>
